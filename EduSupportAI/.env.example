# Sao chép thành .env rồi điền giá trị. Không commit tệp .env.

# demo: chạy trên máy cá nhân | production: bắt buộc đăng nhập cán bộ, ẩn công cụ demo
EDUSUPPORT_ENV=production

# Bắt buộc khi production. Dùng chuỗi dài, ngẫu nhiên.
EDUSUPPORT_OFFICER_PASSWORD=

# Tự động duyệt ca an toàn (quy trình đã xác minh, độ tự tin >= ngưỡng). production mặc định off.
EDUSUPPORT_AUTO_APPROVE=off
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.70

# Mô hình ngôn ngữ cục bộ: auto (dùng nếu có Ollama) hoặc off
EDUSUPPORT_LLM=auto
EDUSUPPORT_LLM_MODEL=qwen2.5:3b

# Địa chỉ mở cổng khi dùng Docker: 127.0.0.1 (chỉ máy này) hoặc 0.0.0.0 (mạng nội bộ, nên đặt sau reverse proxy HTTPS)
APP_BIND=127.0.0.1

# Gửi email thật qua SMTP. Để trống thì chỉ ghi nhật ký mô phỏng.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
